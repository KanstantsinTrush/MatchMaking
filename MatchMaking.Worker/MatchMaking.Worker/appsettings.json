{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Expressions", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning"
      }
    },
    "Enrich": [ "WithEnvironmentName", "WithMachineName", "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "KafkaProducer": {
    "BootstrapServers": "localhost:9092",
    "MatchMakingCompleteEvents": "matchmaking.complete"
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "matchmaking.request.group",
    "MatchMakingRequestEvents": "matchmaking.request"
  },
  "MatchOptions": {
    "UsersPerMatch": 3
  }
}
